{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "check": {},
    "test": { "dependsOn": ["^build"] },
    "eval": { "dependsOn": ["^build"], "cache": false }
  }
}
