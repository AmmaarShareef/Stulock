# Public project URL and anonymous key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for invitations, suspensions, and role changes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A comma-separated emergency owner allowlist used only to bootstrap the first owner.
# Remove it once your owner account has been created.
ADMIN_BOOTSTRAP_EMAILS=you@example.com
